/* SPDX-License-Identifier: AGPL-3.0-or-later */
/*
 * tiered-fees.tlw - the reference Tallow plugin.
 *
 * A fee model and an automation step, run by VENTURE on the sandboxed suet
 * VM. It shows the shape every .tlw plugin has:
 *
 *   - plugin_register() runs once, at load, and is the only place the
 *     `venture.register_*` functions work;
 *   - the functions it registers are pure where they can be: a fee model
 *     is a function from a trade to a fee, nothing else;
 *   - money and rate arithmetic is not written here: `venture_kernels`
 *     calls VENTURE's own compiled kernels, so this plugin rounds exactly
 *     the way the ledger does, at native speed;
 *   - units make "a rate in ppm" and "an amount in minor units" different
 *     types, and contracts state what the fee promises.
 *
 * It asks for no capability: it reads no file, opens no socket, starts no
 * program. Install it by copying it into a plugin directory; see
 * docs/tallow-plugins.org.
 */

import venture;
import venture_kernels as K;

/* parts per million in one whole */
let PPM_ONE = 1000000;

/* one line for the plugin listing */
pure fn plugin_info() -> own str = "Tiered percentage fees and a margin step, in Tallow".dup();

/* registers the fee model and the automation step */
fn plugin_register() ! GError {
	venture.register_fee_model("tiered_ppm",
		"A rate of the trade up to a threshold, a second rate above it",
		"tiered_fee", "tiered_validate")?;
	venture.register_automation_handler("margin_ppm",
		"The margin of a price over a cost, in parts per million of the price",
		"margin")?;
	venture.log("info", "registered fee model tiered_ppm and step margin_ppm");
}

/* ---- the fee model ---- */

/* a rate in ppm read from the venue's parameters, when present and sane */
pure fn rate(params: str, key: str) -> ?i64<K.ppm> = match venture.json_i64(params, key) {
	some r => match r >= 0 && r <= PPM_ONE {
		true => r as i64<K.ppm>,
		false => none,
	},
	none => none,
};

/*
 * The fee on a trade of `amount` minor units: `rate_ppm` of the part up to
 * `above` (minor units), `rate_above_ppm` of the rest; no threshold means
 * one rate throughout. Each part rounds half to even, like the ledger.
 */
pure fn tiered_fee(side: i64, amount: i64, exponent: i64, units: i64, params: str) -> ?i64
	requires amount >= 0 && exponent >= 0 && units >= 1
	ensures match result {
		some fee => fee >= 0 && fee <= amount,
		none => true,
	}
= match rate(params, "rate_ppm") {
	some low => tiers(amount as i64<K.minor>, low,
		rate(params, "rate_above_ppm") ?? low,
		venture.json_i64(params, "above") ?? amount),
	none => none,
};

/* the two parts priced and added */
pure fn tiers(amount: i64<K.minor>, low: i64<K.ppm>, high: i64<K.ppm>, above: i64) -> ?i64
	requires amount >= 0<K.minor>
{
	let cut = match above < 0 || above > amount as i64 {
		true => amount,
		false => above as i64<K.minor>,
	};
	return match K.money_multiply_ppm(cut, low) {
		some first => match K.money_multiply_ppm(amount - cut, high) {
			some second => (first + second) as i64,
			none => none,
		},
		none => none,
	};
}

/* a venue's parameters are acceptable when the rates are */
pure fn tiered_validate(params: str) -> own ?str = match rate(params, "rate_ppm") {
	some _ => match venture.json_i64(params, "rate_above_ppm") {
		some r => match r >= 0 && r <= PPM_ONE {
			true => none,
			false => "rate_above_ppm is parts per million, 0 to 1000000".dup(),
		},
		none => none,
	},
	none => "tiered_ppm needs rate_ppm, parts per million, 0 to 1000000".dup(),
};

/* ---- the automation step ---- */

/* `venture->margin_ppm(price, cost)`: (price - cost) / price in ppm */
pure fn margin(params: str) -> own str ! GError {
	let price = (venture.json_arg(params, 0) ?? "").parse_i64() ?? 0;
	let cost = (venture.json_arg(params, 1) ?? "").parse_i64() ?? 0;
	if price <= 0 {
		fail("margin_ppm needs a positive price");
	}
	let ppm = K.money_multiply_rational((price - cost) as i64<K.minor>, PPM_ONE, price) ?? 0<K.minor>;
	return "{\"margin_ppm\":${ppm as i64}}";
}
