# compose.env.example - secrets and per-host settings for compose.deploy.yaml
#
# Copyright (C) 2026 Zach Podbielniak
# SPDX-License-Identifier: AGPL-3.0-or-later
#
#   cp compose.env.example compose.env
#   chmod 600 compose.env
#
# compose.env is gitignored. This file, with no real values in it, is not.

# ---------------------------------------------------------------------------
# Required. Compose refuses to start without these two.
# ---------------------------------------------------------------------------

# The PostgreSQL password. Used by both containers: postgres initialises the
# role with it, venture reads it via database.password_env.
#
#   openssl rand -base64 24
VENTURE_DB_PASSWORD=

# Signs session cookies. Keep it stable -- changing it logs everyone out.
# Losing it costs a re-login and nothing else; leaking it lets someone forge
# a session, so treat it like a password.
#
#   openssl rand -hex 32
VENTURE_SESSION_SECRET=

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------

# What a browser actually types. Used for absolute links in newsletters and
# webhooks, which are wrong by default if this is not set.
VENTURE_BASE_URL=https://venture.example.com

# Every period boundary and every daily bucket is computed in this zone, so
# "this month" means what you mean by it. IANA name, not an offset.
VENTURE_TIMEZONE=America/New_York

# Assumed when an amount does not name a currency. ISO 4217.
VENTURE_CURRENCY=USD

# error | warn | info | debug
VENTURE_LOG_LEVEL=info

# AI is off until both of these are set. The write policy stays at
# confirm_writes in the compose file regardless: a mutation an AI proposed
# should be one a person approved.
VENTURE_AI_ENABLED=false
ANTHROPIC_API_KEY=
