# Build output
/build/
*.o
*.d
*.a
*.so
*.so.*

# Generated sources
/src/venture-version.h
/compile_commands.json

# Editor / tooling
.cache/
*.swp
*~
\#*\#
.\#*

# Local runtime state
/venture.db
/venture.db-*
*.log
/data/local-config.yaml
/data/local-config.c

# Container compose state. compose.yaml bind-mounts this so the data is
# visible and editable from the host; none of it belongs in the repository.
# The directory itself is kept, so the bind mount has somewhere to land --
# hence ignoring the contents rather than the directory, since git will not
# descend into an ignored directory to find the exception.
/compose-data/*
!/compose-data/.gitkeep

# Secrets for compose.deploy.yaml. compose.env.example is the tracked one.
/compose.env
