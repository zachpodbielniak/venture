prefix=@PREFIX@
exec_prefix=${prefix}
libdir=@LIBDIR@
includedir=@INCLUDEDIR@

Name: venture
Description: ERP/CRM hybrid for running a portfolio of business ventures
Version: @VERSION@
Requires: glib-2.0 gobject-2.0 gio-2.0 gmodule-2.0 json-glib-1.0 libsoup-3.0
Libs: -L${libdir} -lventure
Cflags: -I${includedir}/venture
