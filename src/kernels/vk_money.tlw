/*
 * vk_money.tlw - exact money arithmetic on minor units.
 *
 * An amount is an `i64<minor>` at an exponent (the number of decimal
 * digits its minor unit has: 2 for cents, 0 for yen, up to 6). Two
 * amounts combine at the larger exponent, so nothing is ever rounded away
 * by adding. Rounding happens only where a ratio is applied, always half
 * to even (vk_round), and every operation that could overflow returns an
 * optional instead of wrapping.
 *
 * The currency code is checked by the C shim (src/boxed/venture-money.c)
 * before any of these run: a kernel sees one currency at a time.
 */
module vk_money;

import vk_units;
import vk_round as R;
import tallow.math as M;
import tallow.list as L;

/* the largest exponent VENTURE stores (VENTURE_MONEY_MAX_EXPONENT) */
let MAX_EXPONENT = 6;

/* 10^e for the exponents money uses, as a table so verify sees the values */
pure fn pow10(e: i64) -> i64
	requires e >= 0 && e <= 18
	ensures result >= 1
= match e {
	0 => 1,
	1 => 10,
	2 => 100,
	3 => 1000,
	4 => 10000,
	5 => 100000,
	6 => 1000000,
	7 => 10000000,
	8 => 100000000,
	9 => 1000000000,
	10 => 10000000000,
	11 => 100000000000,
	12 => 1000000000000,
	13 => 10000000000000,
	14 => 100000000000000,
	15 => 1000000000000000,
	16 => 10000000000000000,
	17 => 100000000000000000,
	_ => 1000000000000000000,
};

/* the exponent two amounts combine at: the finer of the two */
pure fn common_exponent(ea: i64, eb: i64) -> i64
	ensures result >= ea && result >= eb
= match ea > eb {
	true => ea,
	false => eb,
};

/*
 * An amount moved from exponent `from` to exponent `to`. Gaining digits is
 * exact and can overflow (none); losing them rounds half to even.
 */
pure fn rescale(amount: i64<minor>, from: i64, to: i64) -> ?i64<minor>
	requires from >= 0 && from <= 18 && to >= 0 && to <= 18
= match to >= from {
	true => match M.checked_mul(amount as i64, pow10(to - from)) {
		some v => v as i64<minor>,
		none => none,
	},
	false => (R.div(amount as i64, pow10(from - to), R.Mode.HalfEven)) as i64<minor>,
};

/* a + b, each at its own exponent, the sum at the common one */
pure fn add(a: i64<minor>, ea: i64, b: i64<minor>, eb: i64) -> ?i64<minor>
	requires ea >= 0 && ea <= 18 && eb >= 0 && eb <= 18
= combine(a, ea, b, eb, false);

/* a - b, each at its own exponent, the difference at the common one */
pure fn subtract(a: i64<minor>, ea: i64, b: i64<minor>, eb: i64) -> ?i64<minor>
	requires ea >= 0 && ea <= 18 && eb >= 0 && eb <= 18
= combine(a, ea, b, eb, true);

/* both operands at the common exponent, then added or subtracted */
pure fn combine(a: i64<minor>, ea: i64, b: i64<minor>, eb: i64, minus: bool) -> ?i64<minor>
	requires ea >= 0 && ea <= 18 && eb >= 0 && eb <= 18
{
	let e = common_exponent(ea, eb);
	return match rescale(a, ea, e) {
		some x => match rescale(b, eb, e) {
			some y => match minus {
				true => M.checked_sub(x as i64, y as i64),
				false => M.checked_add(x as i64, y as i64),
			} |> as_minor,
			none => none,
		},
		none => none,
	};
}

/* a plain optional made a money optional */
pure fn as_minor(v: ?i64) -> ?i64<minor> = match v {
	some x => x as i64<minor>,
	none => none,
};

/* -a, saturating: G_MININT64 has no negation and no real amount reaches it */
pure fn negate(a: i64<minor>) -> i64<minor>
	ensures a == M.I64_MIN as i64<minor> || result == -a
= match a == M.I64_MIN as i64<minor> {
	true => M.I64_MAX as i64<minor>,
	false => -a,
};

/* -1, 0 or 1 as a is below, equal to or above b, each at its own
 * exponent. When one side cannot be brought to the common exponent it is
 * beyond anything the other can be, so its sign decides. */
pure fn compare(a: i64<minor>, ea: i64, b: i64<minor>, eb: i64) -> i64
	requires ea >= 0 && ea <= 18 && eb >= 0 && eb <= 18
	ensures result >= -1 && result <= 1
{
	let e = common_exponent(ea, eb);
	return match rescale(a, ea, e) {
		some x => match rescale(b, eb, e) {
			some y => order(x, y),
			none => -sign(b as i64),
		},
		none => sign(a as i64),
	};
}

/* -1, 0 or 1, without computing x - y (which can overflow) */
pure fn order(x: i64<minor>, y: i64<minor>) -> i64
	ensures result >= -1 && result <= 1
= match x < y {
	true => -1,
	false => match x > y {
		true => 1,
		false => 0,
	},
};

/* amount * factor */
pure fn multiply_int(amount: i64<minor>, factor: i64) -> ?i64<minor>
	= M.checked_mul(amount as i64, factor) |> as_minor;

/*
 * amount * numerator / denominator, rounded half to even once, with the
 * product exact in 128 bits. A negative denominator is folded into the
 * numerator. None for a zero denominator or a result out of range.
 */
pure fn multiply_rational(amount: i64<minor>, numerator: i64, denominator: i64) -> ?i64<minor>
	= match denominator == 0 || denominator == M.I64_MIN || numerator == M.I64_MIN {
	true => none,
	false => match denominator < 0 {
		true => R.mul_div(amount as i64, -numerator, -denominator, R.Mode.HalfEven),
		false => R.mul_div(amount as i64, numerator, denominator, R.Mode.HalfEven),
	} |> as_minor,
};

/* amount at a rate in parts per million, half to even */
pure fn multiply_ppm(amount: i64<minor>, rate: i64<ppm>) -> ?i64<minor>
	= R.mul_div(amount as i64, rate as i64, PPM_ONE, R.Mode.HalfEven) |> as_minor;

/* amount at a rate in basis points (hundredths of a percent), half to even */
pure fn multiply_bp(amount: i64<minor>, rate: i64<bp>) -> ?i64<minor>
	= R.mul_div(amount as i64, rate as i64, 10000, R.Mode.HalfEven) |> as_minor;

/*
 * An amount at exponent `from` converted at numerator/denominator units of
 * the target per unit of the source, to exponent `to`: one rounding, half
 * to even, over an exact 128-bit product. None when the rate is not
 * positive, when rescaling the rate itself overflows (a rate beyond any
 * real currency pair), or when the result is out of range.
 */
pure fn convert(amount: i64<minor>, from: i64, numerator: i64, denominator: i64, to: i64) -> ?i64<minor>
	requires from >= 0 && from <= 18 && to >= 0 && to <= 18
= match numerator <= 0 || denominator <= 0 {
	true => none,
	false => match to >= from {
		true => match M.checked_mul(numerator, pow10(to - from)) {
			some n => R.mul_div(amount as i64, n, denominator, R.Mode.HalfEven) |> as_minor,
			none => none,
		},
		false => match M.checked_mul(denominator, pow10(from - to)) {
			some d => R.mul_div(amount as i64, numerator, d, R.Mode.HalfEven) |> as_minor,
			none => none,
		},
	},
};

/* ---- allocation ---- */

/* the sum of ratios when every one is non-negative and the sum fits and
 * is positive; none otherwise */
pure fn ratio_total(ratios: [i64]) -> ?i64 = ratio_total_from(ratios, 0, 0);

pure fn ratio_total_from(ratios: [i64], i: i64, acc: i64) -> ?i64
	requires i >= 0 && i <= ratios.len() && acc >= 0
	decreases ratios.len() - i
= match i >= ratios.len() {
	true => match acc > 0 {
		true => acc,
		false => none,
	},
	false => match ratios[i] < 0 {
		true => none,
		false => match M.checked_add(acc, ratios[i]) {
			some next => ratio_total_from(ratios, i + 1, next),
			none => none,
		},
	},
};

/* how many slots come before slot i when they are ordered by ratio,
 * largest first, ties by position */
pure fn rank(ratios: [i64], i: i64) -> i64
	requires i >= 0 && i < ratios.len()
= rank_from(ratios, i, 0, 0);

pure fn rank_from(ratios: [i64], i: i64, j: i64, acc: i64) -> i64
	requires i >= 0 && i < ratios.len() && j >= 0 && j <= ratios.len() && acc >= 0
	decreases ratios.len() - j
= match j >= ratios.len() {
	true => acc,
	false => rank_from(ratios, i, j + 1, acc + match ahead(ratios[j], j, ratios[i], i) {
		true => 1,
		false => 0,
	}),
};

/* slot j (ratio rj) comes before slot i (ratio ri) */
pure fn ahead(rj: i64, j: i64, ri: i64, i: i64) -> bool = rj > ri || (rj == ri && j < i);

/* the truncated exact share of each slot: amount * ratio / total */
pure fn shares(amount: i64<minor>, ratios: [i64], total: i64, i: i64, acc: own [i64]) -> own ?[i64]
	requires total > 0 && i >= 0 && i <= ratios.len()
	decreases ratios.len() - i
= match i >= ratios.len() {
	true => acc,
	false => match M.mul_div(amount as i64, ratios[i], total) {
		some part => {
			acc.push(part);
			shares(amount, ratios, total, i + 1, acc)
		},
		none => none,
	},
};

/* parts with the leftover units handed out: slot i gets one unit of the
 * leftover's sign when its rank is below the leftover's magnitude */
pure fn spread(parts: [i64], ratios: [i64], leftover: i64, i: i64, acc: own [i64]) -> own [i64]
	requires i >= 0 && i <= parts.len() && parts.len() == ratios.len()
	decreases parts.len() - i
= match i >= parts.len() {
	true => acc,
	false => {
		acc.push(parts[i] + match rank(ratios, i) < magnitude(leftover) {
			true => sign(leftover),
			false => 0,
		});
		spread(parts, ratios, leftover, i + 1, acc)
	},
};

/* |x| for a leftover, which is smaller than the number of parts */
pure fn magnitude(x: i64) -> i64
	requires x > M.I64_MIN
= match x < 0 {
	true => -x,
	false => x,
};

/*
 * amount split in proportion to ratios, in minor units that sum to amount
 * exactly: each part first gets the truncation of its exact share, then
 * the leftover units (fewer than there are parts) go one each to the
 * largest ratios. None for no parts, a negative ratio, or ratios summing
 * to zero or past i64.
 */
pure fn allocate(amount: i64<minor>, ratios: [i64]) -> own ?[i64]
	ensures match result {
		some parts => parts.len() == ratios.len() && L.sum(parts) == amount as i64,
		none => true,
	}
= match ratio_total(ratios) {
	some total => match shares(amount, ratios, total, 0, []) {
		some parts => spread(parts, ratios, amount as i64 - L.sum(parts), 0, []),
		none => none,
	},
	none => none,
};

/*
 * amount split into n equal parts that sum to amount exactly: the
 * leftover units go one each to the first parts.
 */
pure fn allocate_evenly(amount: i64<minor>, n: i64) -> own ?[i64]
	ensures match result {
		some parts => parts.len() == n && L.sum(parts) == amount as i64,
		none => true,
	}
= match n <= 0 {
	true => none,
	false => evenly(amount as i64 / n, amount as i64 % n, n, 0, []),
};

pure fn evenly(base: i64, leftover: i64, n: i64, i: i64, acc: own [i64]) -> own [i64]
	requires n > 0 && i >= 0 && i <= n
	decreases n - i
= match i >= n {
	true => acc,
	false => {
		acc.push(base + match i < magnitude(leftover) {
			true => sign(leftover),
			false => 0,
		});
		evenly(base, leftover, n, i + 1, acc)
	},
};

test "rescale and add" {
	assert((rescale(123<minor>, 2, 4) ?? 0<minor>) == 12300<minor>);
	assert((rescale(125<minor>, 2, 1) ?? 0<minor>) == 12<minor>);
	assert((rescale(135<minor>, 2, 1) ?? 0<minor>) == 14<minor>);
	assert(rescale(M.I64_MAX as i64<minor>, 2, 6) == none);
	assert((add(150<minor>, 2, 5<minor>, 3) ?? 0<minor>) == 1505<minor>);
	assert((subtract(150<minor>, 2, 5<minor>, 3) ?? 0<minor>) == 1495<minor>);
	assert(add(M.I64_MAX as i64<minor>, 2, 1<minor>, 2) == none);
}

test "compare" {
	assert(compare(100<minor>, 2, 1000<minor>, 3) == 0);
	assert(compare(99<minor>, 2, 1000<minor>, 3) == -1);
	assert(compare(M.I64_MAX as i64<minor>, 0, 1<minor>, 6) == 1);
	assert(compare(M.I64_MIN as i64<minor>, 0, 1<minor>, 6) == -1);
}

test "rates" {
	assert((multiply_rational(1000<minor>, 1, 3) ?? 0<minor>) == 333<minor>);
	assert((multiply_rational(1000<minor>, -1, -3) ?? 0<minor>) == 333<minor>);
	assert(multiply_rational(1000<minor>, 1, 0) == none);
	/* the product overflows 64 bits; the 128-bit path does not care */
	assert((multiply_rational(M.I64_MAX as i64<minor>, 3, 4) ?? 0<minor>) == 6917529027641081855<minor>);
	assert((multiply_bp(10000<minor>, 825<bp>) ?? 0<minor>) == 825<minor>);
	assert((multiply_ppm(10000<minor>, of_pct(15)) ?? 0<minor>) == 1500<minor>);
	assert((convert(50<minor>, 2, 150, 1, 0) ?? 0<minor>) == 75<minor>);
	assert((convert(100<minor>, 0, 1, 150, 2) ?? 0<minor>) == 67<minor>);
	assert((convert(3<minor>, 2, 50, 1, 0) ?? 0<minor>) == 2<minor>);
	assert(convert(M.I64_MAX as i64<minor>, 0, 1, 1, 2) == none);
	assert(negate(M.I64_MIN as i64<minor>) == M.I64_MAX as i64<minor>);
}

test "allocate" {
	let parts = allocate(100<minor>, [1, 1, 1]) ?? [];
	assert(parts.len() == 3 && parts[0] == 34 && parts[1] == 33 && parts[2] == 33);
	let neg = allocate(-100<minor>, [1, 1, 1]) ?? [];
	assert(neg[0] == -34 && neg[1] == -33 && neg[2] == -33);
	let weighted = allocate(1000<minor>, [1, 3, 0]) ?? [];
	assert(weighted[0] == 250 && weighted[1] == 750 && weighted[2] == 0);
	let big = allocate(5<minor>, [3, 3, 1]) ?? [];
	assert(big[0] == 3 && big[1] == 2 && big[2] == 0);
	assert(allocate(5<minor>, []) == none);
	assert(allocate(5<minor>, [0, 0]) == none);
	assert(allocate(5<minor>, [1, -1]) == none);
	let even = allocate_evenly(10<minor>, 3) ?? [];
	assert(even[0] == 4 && even[1] == 3 && even[2] == 3);
	assert(allocate_evenly(10<minor>, 0) == none);
}
