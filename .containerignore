# Keep the build context small and the layer cache honest.
#
# build/ is the big one: shipping a host build tree into the context both
# slows every build and risks the builder picking up objects compiled
# against the host's headers rather than the image's.

build/
deps/*/build/

# Generated from src/venture-version.h.in with the numbers in config.mk. A
# stale copy from a host build shadows the rule that would regenerate it, and
# the image then reports whatever version the host last built.
src/venture-version.h

compose-data/
.git/
# A submodule's .git is a file naming ../../.git/modules/..., which the line
# above leaves out of the context. Shipped alone it is a dangling pointer:
# git inside the build fails "not a git repository" instead of finding no
# repository, and tests that skip when there is no checkout run and fail.
**/.git
.gitignore
.containerignore
*.o
*.a
*.so
compile_commands.json
core
core.*
vgcore.*
tags
TAGS
